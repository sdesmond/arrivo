{
  "name": "packt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:dev": "node scripts/setup-dev.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs --server=kill",
    "test:e2e:affected": "node scripts/run-e2e.mjs --server=kill --affected",
    "test:e2e:reuse-server": "node scripts/run-e2e.mjs --server=reuse",
    "test:e2e:ui": "node scripts/run-e2e.mjs --server=kill --ui",
    "test:e2e:ui:reuse-server": "node scripts/run-e2e.mjs --server=reuse --ui",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset:e2e": "tsx src/db/reset-e2e.ts",
    "db:migrate:e2e": "drizzle-kit push --config=drizzle.config.e2e.ts",
    "db:studio": "drizzle-kit studio",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@mapbox/search-js-core": "^1.5.1",
    "@playwright/cli": "^0.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.4.0",
    "playwright-bdd": "^8.5.1",
    "prettier": "^3.8.3",
    "shadcn": "^4.10.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  }
}
