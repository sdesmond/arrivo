---
// Overrides Starlight's Hero for the home page (the only page with `hero` frontmatter). Tagline and
// buttons still come from index.mdx frontmatter.
import Screenshot from "../Screenshot.astro";
import appVersion from "../../generated/app-version.json";
import logo from "../../assets/brand/arrivo-logo.svg";
import wordmark from "../../assets/brand/arrivo-text.svg";

const { data } = Astro.locals.starlightRoute.entry;
const { tagline, actions = [] } = data.hero ?? {};
const LOGO_HEIGHT = 84;
const WORDMARK_HEIGHT = 56;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="home-hero not-content">
  <h1 id="_top" data-page-title class="home-hero__brand">
    <img
      src={logo.src}
      alt=""
      aria-hidden="true"
      width={Math.round(LOGO_HEIGHT * (411.23917 / 443.29297))}
      height={LOGO_HEIGHT}
    />
    <img
      src={wordmark.src}
      alt="Arrivo"
      width={Math.round(WORDMARK_HEIGHT * (1225.2265 / 356.03836))}
      height={WORDMARK_HEIGHT}
    />
  </h1>
  <p class="home-hero__headline">Plan the whole trip in one place.</p>
  {tagline && <p class="home-hero__tagline" set:html={tagline} />}
  <div class="home-hero__actions">
    {
      actions.map((action, index) => (
        <a
          class:list={["home-button", index === 0 ? "home-button--primary" : "home-button--secondary"]}
          href={action.link}
        >
          {action.text}
        </a>
      ))
    }
  </div>
  <p class="home-hero__meta">
    <a href={`${base}/changelog/`}>Version {appVersion.version}</a>
    <span aria-hidden="true">·</span>
    <span>Self-hosted</span>
    <span aria-hidden="true">·</span>
    <span>AGPL-3.0 licensed</span>
  </p>
  <div class="home-hero__shot">
    <Screenshot
      name="trips"
      alt="Arrivo's Trips page: an active Tokyo trip with a photo cover, showing the event happening now and the next event"
    />
  </div>
</section>
