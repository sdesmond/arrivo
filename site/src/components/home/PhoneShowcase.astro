---
import Screenshot from "../Screenshot.astro";
---

<section class="home-phones not-content">
  <div class="home-phones__copy">
    <p class="home-eyebrow">On the go</p>
    <h2 class="home-h2">Just as usable on your phone</h2>
    <p>
      The layout adapts to small screens, so you can check the plan from the airport as easily as you built it at
      your desk.
    </p>
    <ul class="home-checks">
      <li>Navigation moves to a tab bar along the bottom: Trips, History, Map and Profile.</li>
      <li>Trips are split into Active, Unscheduled and Upcoming tabs.</li>
      <li>The same trip tabs and itinerary are there, with today's day highlighted.</li>
    </ul>
  </div>
  <div class="home-phones__shots">
    <div class="home-phone">
      <Screenshot
        name="mobile-trips"
        alt="Arrivo on a phone: the Trips page with an active Tokyo trip, what is happening now and what is next"
      />
    </div>
    <div class="home-phone">
      <Screenshot
        name="mobile-itinerary"
        alt="Arrivo on a phone: the Tokyo itinerary with today's day expanded and the tab bar along the bottom"
      />
    </div>
  </div>
</section>
