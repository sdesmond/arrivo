# Packt — Docker Compose configuration.
# Copy to .env next to docker-compose.yml, or enter the same variables in your stack tool's
# environment settings. See docs/self-hosting.md for details.

# Required. Signs session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Exact URL people type into their browser to reach Packt, including the port, e.g.
#   http://192.168.1.50:3000   or   https://packt.example.com (behind a reverse proxy)
NEXTAUTH_URL=http://localhost:3000

# Host port the app is published on. If you change it, change the port in NEXTAUTH_URL too.
PACKT_PORT=3000

# Host folder holding the database (pgdata/) and uploads (storage/). Use an absolute path when
# docker-compose.yml lives outside the cloned repo.
PACKT_DATA_DIR=./data

# Path to the cloned repo (the Docker build context). Use an absolute path when docker-compose.yml
# lives outside the cloned repo.
PACKT_SRC_DIR=.

# Set to false once your account(s) exist to disable the sign-up page.
ALLOW_SIGNUP=true

# Optional. Mapbox public token (https://account.mapbox.com/access-tokens/).
# The same token works for both. Leave blank to run without maps/geocoding.
# NEXT_PUBLIC_MAPBOX_TOKEN is baked in at build time — rebuild after changing it.
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional. Unsplash access key (https://unsplash.com/developers) for trip cover-image search.
UNSPLASH_ACCESS_KEY=
