# Packt — Docker Compose configuration.
# Copy to .env next to docker-compose.yml, or enter the same variables in your stack tool's
# environment settings. See docs/self-hosting.md for details.

# Required. Signs session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Exact URL people type into their browser to reach Packt, including the port, e.g.
#   http://192.168.1.50:3000   or   https://packt.example.com (behind a reverse proxy)
NEXTAUTH_URL=http://localhost:3000

# Image version to run: a release like 0.2.0 (recommended — upgrades only when you change it),
# or latest for the newest release. See docs/self-hosting.md.
PACKT_VERSION=latest

# Host port the app is published on. If you change it, change the port in NEXTAUTH_URL too.
PACKT_PORT=3000

# Host folder holding the database (pgdata/) and uploads (storage/). Relative paths resolve
# against the folder containing docker-compose.yml; absolute paths work anywhere.
PACKT_DATA_DIR=./data

# Set to false once your account(s) exist to disable the sign-up page.
ALLOW_SIGNUP=true

# Optional. Mapbox public token (https://account.mapbox.com/access-tokens/).
# Leave blank to run without maps/geocoding.
# Browsers also receive this token for the map, so use a public (pk.) token, never a secret (sk.) one.
MAPBOX_ACCESS_TOKEN=
# Optional: a separate, URL-restricted public token for browsers only. Blank = reuse the one above.
MAPBOX_PUBLIC_TOKEN=

# Optional. Unsplash access key (https://unsplash.com/developers) for trip cover-image search.
UNSPLASH_ACCESS_KEY=
