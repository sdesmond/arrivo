{
  "permissions": {
    "allow": [
      "Bash(Get-ChildItem *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(npx eslint *)",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_wait_for",
      "Skill(bmad-quick-dev)",
      "Skill(bmad-agent-builder)",
      "Skill(bmad-brainstorming)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; f=json.load(sys.stdin).get('tool_input',{}).get('file_path',''); print(f) if f else None\" | { read -r f; [ -n \"$f\" ] && npx prettier --write \"$f\" --ignore-unknown && npx eslint --fix \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true
  }
}