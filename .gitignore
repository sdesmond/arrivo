# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
.features-gen/
/coverage
/test-results

# e2e auth state
tests/e2e/.auth/

# next.js
/.next/
/.next-e2e/
/.next-validate/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
.playwright-mcp
.ui-review-screenshots
.claude/settings.local.json

# legacy local upload data
/public/uploads/
/drizzle/

# storage adapter local roots
/.e2e-storage/
/.dev-storage/

# bmad framework installation (reinstallable from manifest)
_bmad/**
!_bmad/_config/
!_bmad/_config/manifest.yaml
!_bmad/custom/
!_bmad/custom/**
_bmad/custom/*.user.toml

# AI Agents
.opencode/plans/
.claude/skills
.claude/agents

/coverage-out
