{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-validate/types/**/*.ts",
    ".next-validate/dev/types/**/*.ts",
    ".next-e2e-bootstrap/types/**/*.ts",
    ".next-e2e-bootstrap/dev/types/**/*.ts",
    ".next-e2e-policy-0/types/**/*.ts",
    ".next-e2e-policy-0/dev/types/**/*.ts",
    ".next-e2e-policy-1/types/**/*.ts",
    ".next-e2e-policy-1/dev/types/**/*.ts",
    ".next-e2e-policy-2/types/**/*.ts",
    ".next-e2e-policy-2/dev/types/**/*.ts",
    ".next-e2e-policy-3/types/**/*.ts",
    ".next-e2e-policy-3/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "site",
    ".next-e2e",
    ".next-e2e-bootstrap",
    ".next-e2e-policy-0",
    ".next-e2e-policy-1",
    ".next-e2e-policy-2",
    ".next-e2e-policy-3"
  ]
}
