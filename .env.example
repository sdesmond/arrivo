DATABASE_URL=postgres://arrivo:arrivo@localhost:5432/arrivo
E2E_DATABASE_URL=postgres://arrivo:arrivo@localhost:5432/arrivo_e2e
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-32-bytes-min
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts passport numbers and MFA secrets; never change it once set.
DATA_ENCRYPTION_KEY=
E2E_USERNAME=e2e
E2E_PASSWORD=e2e1234
HIDE_OVERLAY=true
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT_DIR=./.dev-storage
MAPBOX_ACCESS_TOKEN=mapbox-token-goes-here
UNSPLASH_ACCESS_KEY=unsplash-access-key-goes-here
